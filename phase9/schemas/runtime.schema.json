{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Record",
  "type": "object",
  "required": ["id", "experiment_id", "metric", "value"],
  "properties": {
    "id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "metric": {"type": "string"},
    "value": {"type": "number"},
    "unit": {"type": ["string", "null"]},
    "measurement_window": {"type": ["object", "null"]}
  }
}
